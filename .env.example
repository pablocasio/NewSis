# Base de datos (cadena de conexión de Neon: Dashboard de Neon > Connection string)
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# Correo (SMTP) para reportes y alertas
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="contraseña-de-aplicacion"
REPORT_EMAIL_TO="admin-negocio@gmail.com"

# Negocio
BUSINESS_NAME="Mi Abarrotes"
LOW_STOCK_THRESHOLD=5
